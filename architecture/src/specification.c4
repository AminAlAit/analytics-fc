specification {
  element actor {
    style {
      shape person
    }
  }

  element system
  element container
  element component

  relationship sync {
    line solid
    head vee
  }

  relationship async {
    line dashed
    head diamond
  }

  relationship fallback {
    line dotted
    head open
    color red
  }

  relationship batch {
    line dashed
    head vee
    color blue
  }

  tag built {
    color green
  }

  tag in_progress {
    color amber
  }

  tag backlog {
    color gray
  }
}
